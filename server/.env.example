# Database
DATABASE_URL=postgresql://user:password@localhost:5432/optionstaxhub

# API Keys
API_KEY_SECRET=your_secret_key_here

# CORS
FRONTEND_URL=http://localhost:3000

# Local API port (canonical: 8011). Production on Render injects $PORT; do not hardcode 8011 there.
PORT=8011

# Set to "development" to enable auto-reload (local dev only)
ENVIRONMENT=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Push Notifications (Web Push)
# Generate keys with: npm run generate:vapid-keys (in client folder)
# For local development, see .vapid-keys file
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_CLAIM_EMAIL=mailto:your-email@example.com

# Stripe
# Production (Render main) uses STRIPE_SECRET_KEY (live).
# Staging / local year-close packet checkout MUST use TEST keys so accept
# can pay with a Stripe test card. Never set a live key as STRIPE_SECRET_KEY_TEST.
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_SECRET_KEY_TEST=sk_test_your_test_secret_key
STRIPE_FORCE_TEST_MODE=true
STRIPE_WEBHOOK_SECRET=
